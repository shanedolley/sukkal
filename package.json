{
  "name": "sukkal",
  "version": "0.1.0",
  "private": true,
  "description": "Sukkal: the memory store and its migration.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "migrate": "node --env-file-if-exists=$HOME/.config/sukkal/env src/db/migrate.ts",
    "worker": "node --env-file-if-exists=$HOME/.config/sukkal/env src/worker/index.ts",
    "test": "node --env-file-if-exists=$HOME/.config/sukkal/env --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "lint": "oxlint src test scripts --import-plugin --deny-warnings",
    "embed": "node --env-file-if-exists=$HOME/.config/sukkal/env scripts/embed.ts",
    "decisions": "node --experimental-strip-types scripts/decision-register.ts",
    "build": "tsc --noEmit",
    "ci:local": "act push"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "pg-boss": "^12.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "oxlint": "1.80.0",
    "typescript": "^7.0.2"
  }
}
