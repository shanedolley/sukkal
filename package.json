{
  "name": "kpa",
  "version": "0.1.0",
  "private": true,
  "description": "Koinon Personal Assistant: the memory store and its migration.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=$HOME/.config/kpa/env src/db/migrate.ts",
    "worker": "node --env-file-if-exists=$HOME/.config/kpa/env src/worker/index.ts",
    "test": "node --env-file-if-exists=$HOME/.config/kpa/env --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "lint": "oxlint src test --import-plugin --deny-warnings",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "pg-boss": "^12.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "oxlint": "1.80.0",
    "typescript": "^7.0.2"
  }
}
