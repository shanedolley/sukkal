# The variables KPA reads. This file names them and holds no value.
#
# Real values live outside the repository, at ~/.config/kpa/env, mode 0600.
# docs/runbooks/secrets.md says how to create that file and why it lives there.
#
# Format, for both:
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
#
# DATABASE_URL          the migration target: the database that holds the
#                       facts.
# DATABASE_URL_TEST     the test target. Tests and rehearsals write here, and
#                       never into the database above.
# NABIUM_WEBHOOK_SECRET the shared secret nabium signs its webhook deliveries
#                       with. Unset, src/webhooks/receive.ts refuses every
#                       delivery. See ADR-0013.
#
# Both database URLs need sslmode=require. amaterasu refuses a client
# offering no TLS, and src/db/connect.ts refuses a mode that does not
# encrypt.

DATABASE_URL=
DATABASE_URL_TEST=
NABIUM_WEBHOOK_SECRET=
