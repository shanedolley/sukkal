# Copy to .env and fill in. .env is git-ignored and must stay that way.
#
# DATABASE_URL       the migration target: the database that holds the facts.
# DATABASE_URL_TEST  the test target. Tests and rehearsals write here, and
#                    never into the database above.
#
# Both need sslmode=require. amaterasu refuses a client offering no TLS.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kpa?sslmode=require
DATABASE_URL_TEST=postgresql://USER:PASSWORD@HOST:5432/kpa_dev?sslmode=require
